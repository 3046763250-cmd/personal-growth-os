---
import Base from '../layouts/Base.astro';
import LineChart from '../components/LineChart.astro';
import profile from '../data/profile.json';
import growth from '../data/growth.json';
import projects from '../data/projects.json';
import skills from '../data/skills.json';
import timeline from '../data/timeline.json';

const pct = Math.round(growth.study.total / growth.study.goal * 100);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <section class="hero hero-home">
    <div class="hero-main">
      <p class="eyebrow">LIU YINGJIE · PERSONAL GROWTH OS</p>
      <h1><span>刘映杰</span><small>Liu Yingjie</small></h1>
      <p class="hero-thesis">把学习、训练和项目，<br>变成可以被验证的成长。</p>
    </div>
    <aside class="hero-brief" aria-label="当前状态摘要">
      <p class="hero-index">01 / WHO & NOW</p>
      <p>{profile.statement}</p>
      <dl>
        <div><dt>Current</dt><dd>考研 · 学习 · 训练</dd></div>
        <div><dt>Building</dt><dd>长期能力与项目证据</dd></div>
        <div><dt>Updated</dt><dd>{profile.updated}</dd></div>
      </dl>
      <div class="actions"><a class="primary" href={`${base}/projects/`}>查看项目</a><a href="#dashboard">查看进度 ↓</a></div>
    </aside>
    <p class="hero-motto">{profile.motto} <span>{profile.mottoEn}</span></p>
  </section>

  <section class="section dashboard" id="dashboard">
    <div class="section-head">
      <p class="eyebrow">02 / GROWTH DASHBOARD</p>
      <h2>成长不是感觉，<br>而是一组持续更新的证据。</h2>
      <p>所有数字均为 Example data，用于展示数据结构与呈现方式；真实记录补充后会自动同步。</p>
    </div>
    <div class="dashboard-grid">
      <div class="dashboard-kpis">
        <article class="kpi kpi-feature"><span>考研学习进度</span><strong>{pct}<small>%</small></strong><progress value={growth.study.total} max={growth.study.goal}>{pct}%</progress><em>{growth.study.total} / {growth.study.goal} 小时</em></article>
        <article class="kpi"><span>本周学习</span><strong>{growth.study.week}<small> h</small></strong><em>连续 {growth.study.streak} 天</em></article>
        <article class="kpi"><span>身体训练</span><strong>{growth.fitness.workouts}<small> 次</small></strong><em>累计记录</em></article>
        <article class="kpi"><span>篮球训练</span><strong>{growth.basketball.sessions}<small> 次</small></strong><em>{growth.basketball.hours} 小时</em></article>
      </div>
      <div class="dashboard-chart"><LineChart values={growth.study.weekly} label="近 7 周学习时长" unit="小时 · Example data" /><a href={`${base}/growth/`}>查看完整成长仪表盘 →</a></div>
    </div>
  </section>

  <section class="section skills-section">
    <div class="section-head">
      <p class="eyebrow">03 / SKILLS</p>
      <h2>正在构建的，<br>不是标签，而是能力组合。</h2>
      <p>技能只有被项目、行动与结果支持时才有意义。这里区分已使用工具与仍在发展的能力方向。</p>
    </div>
    <div class="skill-rows">{skills.map((skill, index) => <article><span>0{index + 1}</span><h3>{skill.group}</h3><ul>{skill.items.map(item => <li>{item}</li>)}</ul><p>{skill.note}</p></article>)}</div>
  </section>

  <section class="section projects-home">
    <div class="section-head">
      <p class="eyebrow">04 / SELECTED PROJECTS</p>
      <h2>用作品解释：<br>我如何发现并解决问题。</h2>
      <p>每个项目都围绕 Problem、Process、Result 与 Learning 展开，不只罗列工具。</p>
    </div>
    <div class="project-list">{projects.map((project, index) => <article class="project-card" id={project.slug}>
      <div class="project-number">0{index + 1}</div>
      <div class="project-title"><span>{project.status} · {project.placeholder ? '示例案例' : '真实案例'}</span><h3>{project.name}</h3><p>{project.goal}</p></div>
      <dl><div><dt>Role</dt><dd>{project.role}</dd></div><div><dt>Tools</dt><dd>{project.tools.join(' · ')}</dd></div><div><dt>Result</dt><dd>{project.result}</dd></div></dl>
      <a href={`${base}/projects/#${project.slug}`} aria-label={`阅读 ${project.name} 案例`}>案例详情 ↗</a>
    </article>)}</div>
  </section>

  <section class="section timeline-section">
    <div class="section-head">
      <p class="eyebrow">05 / TIMELINE</p>
      <h2>把现在放进一条<br>更长的时间线里。</h2>
      <p>这不是包装完成度，而是公开当前阶段、下一步与长期方向。</p>
    </div>
    <ol class="timeline">{timeline.map((item, index) => <li><div class="timeline-marker"><span>{index + 1}</span></div><time>{item.date}</time><div><h3>{item.title}</h3><p>{item.description}</p></div><em>{item.status}</em></li>)}</ol>
  </section>

  <section class="direction">
    <p class="eyebrow">06 / NEXT STEP</p>
    <h2>继续学习，持续行动，<br>让下一次更新有真实证据。</h2>
    <div class="actions"><a class="primary" href={`${base}/about/`}>了解刘映杰</a><a href={profile.github}>查看 GitHub →</a></div>
  </section>
</Base>
